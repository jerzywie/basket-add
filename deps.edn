{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        mixradio/radix {:mvn/version "1.0.20"}
        clj-http/clj-http {:mvn/version "3.6.1"}
        enlive/enlive {:mvn/version "1.1.6"}
        dk.ative/docjure {:mvn/version "1.10.0"}}
 :aliases
 {:run-m {:main-opts ["-m" "basket-add.core"]}
  :run-x {:ns-default basket-add.core
          :exec-fn greet
          :exec-args {:name "Clojure"}}
  :uberjar {:replace-deps {com.github.seancorfield/depstar {:mvn/version "2.0.216"}}
            :exec-fn hf.depstar/uberjar
            :exec-args {:aot true
                        :jar "target/basket-add.jar"
                        :main-class "basket-add.core"}}}
 :test {:extra-paths ["test"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                     io.github.cognitect-labs/test-runner
                     {:git/tag "v0.5.0" :git/sha "48c3c67"}}}}
